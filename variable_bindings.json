  "live_preview_commands": {
    "description": "Команды, которые выполняются в реальном времени при выборе ответа в диагностике. Каждая команда = мгновенное изменение одной CSS-переменной на :root или параметра Three.js.",
    "execution_order": [
      "1. Применить vector_delta к текущему userVector",
      "2. Вычислить промежуточный архетип через getRankings()",
      "3. Интерполировать CSS-переменные между текущим значением и целевым",
      "4. Обновить Three.js материал и геометрию",
      "5. Запустить easing-анимацию перехода (300ms)"
    ],
    "interpolation": {
      "type": "lerp",
      "duration_ms": 300,
      "css_properties": "Все переменные на :root интерполируются через CSS transition",
      "threejs_properties": "Интерполируются через requestAnimationFrame с easing"
    }
  },

  "extended_css_variables": {
    "description": "Расширенные CSS-переменные, которые необходимо добавить в :root для полной поддержки системы.",
    "new_variables": [
      {
        "name": "--backdrop-blur",
        "default": "blur(8px)",
        "type": "filter",
        "applies_to": ".bg-glass, .panel, .modal",
        "note": "Заменяет ручное указание blur в background. Динамически меняется через Pivot."
      },
      {
        "name": "--grid-opacity",
        "default": "0.06",
        "type": "number",
        "applies_to": "canvas grid lines",
        "note": "Прозрачность сетки на поле архетипов."
      },
      {
        "name": "--transmission",
        "default": "0.5",
        "type": "number [0,1]",
        "applies_to": "glass layers",
        "note": "Коэффициент пропускания света через стеклянные панели."
      },
      {
        "name": "--surface-roughness",
        "default": "0.4",
        "type": "number [0,1]",
        "applies_to": "panel surfaces",
        "note": "Шероховатость поверхности: 0 = глянец, 1 = матовый."
      },
      {
        "name": "--specular-intensity",
        "default": "0.5",
        "type": "number [0,1]",
        "applies_to": "highlights",
        "note": "Интенсивность бликов на стеклянных поверхностях."
      },
      {
        "name": "--spring-tension",
        "default": "200",
        "type": "number",
        "applies_to": "all spring animations",
        "note": "Жёсткость пружины для физических анимаций."
      },
      {
        "name": "--spring-friction",
        "default": "20",
        "type": "number",
        "applies_to": "all spring animations",
        "note": "Трение пружины (затухание)."
      },
      {
        "name": "--spring-mass",
        "default": "1",
        "type": "number",
        "applies_to": "all spring animations",
        "note": "Масса для инерционных анимаций."
      },
      {
        "name": "--heading-weight",
        "default": "500",
        "type": "number",
        "applies_to": "h1, h2, h3",
        "note": "Динамический вес заголовков."
      },
      {
        "name": "--heading-letter-spacing",
        "default": "0em",
        "type": "length",
        "applies_to": "h1, h2, h3",
        "note": "Межбуквенное расстояние заголовков."
      },
      {
        "name": "--saturation-boost",
        "default": "1.0",
        "type": "number",
        "applies_to": "all accent colors",
        "note": "Множитель насыщенности для акцентных цветов."
      },
      {
        "name": "--contrast-multiplier",
        "default": "1.0",
        "type": "number",
        "applies_to": "text and borders",
        "note": "Множитель контраста текста и границ."
      }
    ]
  },

  "threejs_bindings": {
    "description": "Переменные, управляющие Three.js сценой (3D-ядро бренда).",
    "properties": {
      "core_geometry": {
        "type": "enum",
        "values": ["icosahedron", "sphere", "torus_knot", "dodecahedron", "metaball", "box"],
        "default": "icosahedron",
        "effect": "Базовая форма 3D-ядра в центре поля"
      },
      "wireframe": {
        "type": "boolean",
        "default": false,
        "effect": "Каркасный режим отображения геометрии"
      },
      "subdivision": {
        "type": "integer [0,4]",
        "default": 1,
        "effect": "Уровень подразделения геометрии (0 = острые грани, 4 = почти сфера)"
      },
      "material_type": {
        "type": "enum",
        "values": ["MeshStandardMaterial", "MeshPhysicalMaterial", "MeshToonMaterial"],
        "default": "MeshPhysicalMaterial",
        "effect": "Тип материала Three.js"
      },
      "roughness": {
        "type": "number [0,1]",
        "default": 0.4,
        "effect": "Шероховатость поверхности 3D-ядра"
      },
      "metalness": {
        "type": "number [0,1]",
        "default": 0.2,
        "effect": "Металличность поверхности"
      },
      "glow_intensity": {
        "type": "number [0,2]",
        "default": 0.6,
        "effect": "Интенсивность свечения вокруг ядра"
      },
      "particle_density": {
        "type": "integer [0,300]",
        "default": 80,
        "effect": "Количество частиц в ореоле"
      },
      "rotation_speed": {
        "type": "number",
        "default": 0.3,
        "effect": "Скорость авто-вращения ядра (rad/s)"
      },
      "camera_distance": {
        "type": "number",
        "default": 5.5,
        "effect": "Дистанция камеры до ядра"
      },
      "fov": {
        "type": "number [20,80]",
        "default": 45,
        "effect": "Угол обзора камеры (низкий = телевик, высокий = широкий угол)"
      },
      "metaball": {
        "type": "boolean",
        "default": false,
        "effect": "Режим метабола (текучая органическая форма)"
      }
    }
  }
}
