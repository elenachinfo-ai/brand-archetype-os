{
  "_meta": {
    "description": "Математика визуализации ArchetypeOS: карта связей ответов → CSS/Three.js переменных",
    "version": "1.0.0",
    "principle": "Каждый ответ в диагностике — это не текст, а команда. Эта карта определяет, как именно вектор архетипа трансформируется в конкретные пиксели.",
    "integration": "Используется Pivot.execute() для мгновенной смены темы и diagnostic_questions_v4.json для live-preview в ходе опроса."
  },

  "dimensions": {
    "control": {
      "label": "Контроль",
      "range": [0, 100],
      "css_variables": [
        "--radius-sm",
        "--radius-md",
        "--radius-lg",
        "--border-subtle",
        "--border-mid",
        "--grid-opacity",
        "--heading-weight",
        "--contrast-multiplier"
      ],
      "threejs": ["wireframe", "icosahedron_subdivision"],
      "mapping": "linear: high control = smaller radius, more grid, heavier type"
    },
    "energy": {
      "label": "Энергия",
      "range": [0, 100],
      "css_variables": [
        "--transition-fast",
        "--transition-normal",
        "--glow-strong",
        "--glow-blue",
        "--saturation-boost",
        "--accent-size"
      ],
      "threejs": ["glow_intensity", "particle_density", "rotation_speed"],
      "mapping": "exponential: high energy = faster transitions, stronger glow, more particles"
    },
    "focus": {
      "label": "Фокус",
      "range": [0, 100],
      "css_variables": [
        "--bg-glass",
        "--bg-glass-strong",
        "--backdrop-blur",
        "--blur-behind",
        "--depth-shadow",
        "--parallax-intensity"
      ],
      "threejs": ["camera_distance", "fov"],
      "mapping": "logarithmic: high focus = more blur layers, deeper stacking, narrower FOV"
    },
    "method": {
      "label": "Метод",
      "range": [0, 100],
      "css_variables": [
        "--color-interpolation",
        "--gradient-stops",
        "--hue-variance",
        "--chroma-shift",
        "--palette-mode",
        "--transition-slow",
        "--spring-tension",
        "--spring-friction"
      ],
      "threejs": ["material_type", "roughness", "metalness"],
      "mapping": "threshold: high method = complex color spaces (oklch), more gradient stops, spring physics"
    }
  },

